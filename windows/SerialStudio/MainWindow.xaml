<Window
    x:Class="SerialStudio.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SerialStudio"
    Title="Serial Studio">
  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>
  <Grid x:Name="Root" Loaded="OnLoaded" SizeChanged="OnRootSizeChanged">
    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="OnConnectShortcut" />
      <KeyboardAccelerator Key="Enter" Modifiers="Control" Invoked="OnSendShortcut" />
      <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="OnRefreshShortcut" />
      <KeyboardAccelerator Key="L" Modifiers="Control" Invoked="OnClearShortcut" />
      <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnFindShortcut" />
      <KeyboardAccelerator Key="I" Modifiers="Control" Invoked="OnInspectorShortcut" />
    </Grid.KeyboardAccelerators>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TitleBar x:Name="AppTitleBar" Title="Serial Studio" Subtitle="串口终端">
      <TitleBar.IconSource>
        <FontIconSource Glyph="&#xE756;" />
      </TitleBar.IconSource>
    </TitleBar>

    <CommandBar Grid.Row="1" DefaultLabelPosition="Right" Background="Transparent" Margin="12,0,12,8">
      <CommandBar.Content>
        <StackPanel Margin="8,4,16,4" Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="串口终端" Style="{ThemeResource SubtitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" />
          <TextBlock x:Name="SessionSubtitle" Text="选择设备后即可开始" FontSize="12"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="380" />
        </StackPanel>
      </CommandBar.Content>
      <AppBarButton x:Name="ConnectButton" Label="连接" Icon="Play" Click="OnConnect" ToolTipService.ToolTip="连接或断开串口 (Ctrl+K)" />
      <AppBarSeparator />
      <AppBarToggleButton x:Name="InspectorToggle" Label="连接设置" Icon="Setting" IsChecked="True"
                          Click="OnInspector" ToolTipService.ToolTip="显示或隐藏连接设置 (Ctrl+I)" />
      <CommandBar.SecondaryCommands>
        <AppBarButton x:Name="CheckUpdateButton" Label="检查更新" Icon="Download" Click="OnCheckUpdate" />
        <AppBarButton x:Name="ApplyUpdateButton" Label="安装更新" Icon="Refresh" Click="OnApplyUpdate" Visibility="Collapsed" />
        <AppBarSeparator />
        <AppBarButton Label="设置" Icon="Setting" Click="OnSettings" />
      </CommandBar.SecondaryCommands>
    </CommandBar>

    <Grid Grid.Row="2" ColumnSpacing="12" Margin="12,0,12,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="216" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Grid RowSpacing="8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="8,8,4,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="串口设备" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2" />
            <TextBlock x:Name="PortCount" Text="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>
          <Button x:Name="RefreshButton" Grid.Column="1" Click="OnRefresh" Background="Transparent" BorderThickness="0"
                  AutomationProperties.Name="刷新串口" ToolTipService.ToolTip="刷新串口 (Ctrl+R)">
            <FontIcon Glyph="&#xE72C;" FontSize="14" />
          </Button>
        </Grid>
        <Grid Grid.Row="1">
          <ListView x:Name="PortPicker" SelectionMode="Single" SelectionChanged="OnSelectionChanged"
                    AutomationProperties.Name="串口设备" Background="Transparent"
                    ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Margin" Value="0,2" />
                <Setter Property="Padding" Value="10,8" />
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
              <DataTemplate>
                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <FontIcon Glyph="&#xE88E;" FontSize="18" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Path}" FontSize="12" TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
          <StackPanel x:Name="DeviceEmptyState" VerticalAlignment="Center" Margin="16" Spacing="10">
            <FontIcon Glyph="&#xE88E;" FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="未发现设备" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="接入串口设备后，会自动显示在这里。" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </Grid>
        <Button Grid.Row="2" Click="OnSettings" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Background="Transparent" BorderThickness="0" Margin="0,8,0,4">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <FontIcon Glyph="&#xE713;" FontSize="16" />
            <TextBlock Text="设置" />
          </StackPanel>
        </Button>
      </Grid>

      <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
        <SplitView x:Name="ConnectionInspector" PanePlacement="Right" DisplayMode="Inline" IsPaneOpen="True"
                   OpenPaneLength="272" PaneBackground="{ThemeResource LayerFillColorDefaultBrush}"
                   PaneOpened="OnInspectorPaneOpened" PaneClosed="OnInspectorPaneClosed">
          <SplitView.Pane>
            <Border BorderThickness="1,0,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
              <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="20" Spacing="20">
                  <TextBlock Text="连接设置" Style="{ThemeResource SubtitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
                  <TextBlock x:Name="ConfigHint" Text="选择设备并确认通信参数。" TextWrapping="Wrap" FontSize="12"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  <StackPanel x:Name="ConfigPanel" Spacing="16">
                    <ComboBox x:Name="BaudPicker" Header="波特率" HorizontalAlignment="Stretch" SelectionChanged="OnSelectionChanged" />
                    <Grid ColumnSpacing="12">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <ComboBox x:Name="DataBitsPicker" Header="数据位" HorizontalAlignment="Stretch" SelectionChanged="OnSelectionChanged" />
                      <ComboBox x:Name="StopBitsPicker" Grid.Column="1" Header="停止位" HorizontalAlignment="Stretch" SelectionChanged="OnSelectionChanged" />
                    </Grid>
                    <ComboBox x:Name="ParityPicker" Header="校验位" HorizontalAlignment="Stretch" SelectionChanged="OnSelectionChanged" />
                    <ComboBox x:Name="FlowPicker" Header="流控制" HorizontalAlignment="Stretch" SelectionChanged="OnSelectionChanged" />
                  </StackPanel>
                  <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                  <TextBlock Text="设备信息" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level3" />
                  <TextBlock x:Name="PortDetails" Text="从左侧选择一个串口设备。" TextWrapping="Wrap"
                             IsTextSelectionEnabled="True" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
              </ScrollViewer>
            </Border>
          </SplitView.Pane>

          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <InfoBar x:Name="ErrorBar" IsOpen="False" Severity="Error" IsClosable="True" Margin="12,12,12,0" />
            <Grid Grid.Row="1" Padding="16,12" ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="数据终端" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2" />
                <TextBlock x:Name="FrameCount" Text="0 条记录" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>
              <ComboBox x:Name="DirectionPicker" Grid.Column="1" SelectedIndex="0" MinWidth="100" VerticalAlignment="Center"
                        AutomationProperties.Name="数据方向" SelectionChanged="OnFilterChanged">
                <ComboBoxItem Content="全部方向" />
                <ComboBoxItem Content="接收 RX" />
                <ComboBoxItem Content="发送 TX" />
              </ComboBox>
              <ComboBox x:Name="DisplayPicker" Grid.Column="2" MinWidth="88" VerticalAlignment="Center"
                        AutomationProperties.Name="显示编码" SelectionChanged="OnDisplayChanged" />
            </Grid>
            <Grid Grid.Row="2" Padding="16,0,16,12" ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="TerminalSearch" PlaceholderText="搜索数据 (Ctrl+F)" AutomationProperties.Name="搜索终端数据"
                       TextChanged="OnSearchChanged" />
              <ToggleButton x:Name="AutoScrollToggle" Grid.Column="1" Content="自动滚动" IsChecked="True"
                            Click="OnAutoScroll" ToolTipService.ToolTip="跟随最新的数据" />
              <Button x:Name="ClearButton" Grid.Column="2" Click="OnClear" AutomationProperties.Name="清空终端"
                      ToolTipService.ToolTip="清空终端 (Ctrl+L)">
                <FontIcon Glyph="&#xE74D;" FontSize="14" />
              </Button>
            </Grid>

            <Grid Grid.Row="3">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1">
                <Grid Padding="16,7" ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="时间" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  <TextBlock Grid.Column="1" Text="方向" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  <TextBlock Grid.Column="2" Text="字节" FontSize="12" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  <TextBlock Grid.Column="3" Text="数据" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
              </Border>
              <ListView x:Name="Terminal" Grid.Row="1" SelectionMode="None" Background="{ThemeResource ControlAltFillColorQuarternaryBrush}"
                        ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                  <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="16,7" />
                    <Setter Property="MinHeight" Value="30" />
                    <Setter Property="IsTabStop" Value="False" />
                  </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                  <DataTemplate x:DataType="local:TerminalFrame">
                    <Grid ColumnSpacing="12">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{x:Bind Time}" FontFamily="Consolas" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                      <TextBlock Grid.Column="1" Text="{x:Bind Direction}" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="2" Text="{x:Bind Size}" FontFamily="Consolas" FontSize="12" HorizontalAlignment="Right"
                                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                      <TextBlock Grid.Column="3" Text="{x:Bind DisplayText, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                 FontFamily="Consolas" FontSize="13" />
                    </Grid>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
              <StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Margin="24" MaxWidth="320">
                <FontIcon Glyph="&#xE756;" FontSize="36" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="EmptyTitle" Text="准备连接" Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyDescription" Text="选择串口，确认连接设置，然后点击“连接”。" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button x:Name="ResetFiltersButton" Content="清除筛选" Click="OnResetFilters" HorizontalAlignment="Center" Visibility="Collapsed" />
              </StackPanel>
            </Grid>

            <Border Grid.Row="4" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
              <StackPanel Padding="16" Spacing="10">
                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="发送数据" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2" />
                  <ComboBox x:Name="SendFormatPicker" Grid.Column="1" MinWidth="88" AutomationProperties.Name="发送编码" SelectionChanged="OnSelectionChanged" />
                  <ComboBox x:Name="EndingPicker" Grid.Column="2" MinWidth="80" AutomationProperties.Name="行尾" SelectionChanged="OnSelectionChanged" />
                </Grid>
                <TextBox x:Name="InputBox" AcceptsReturn="True" TextWrapping="Wrap" Height="84" PlaceholderText="输入文本或设备指令…"
                         AutomationProperties.Name="要发送的数据" FontFamily="Consolas" TextChanged="OnInputChanged" />
                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="SendHint" Text="Ctrl+Enter 发送 · Enter 换行" FontSize="12" VerticalAlignment="Center"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                  <Button x:Name="SendButton" Grid.Column="1" Content="发送 ↑" MinWidth="88" Style="{ThemeResource AccentButtonStyle}"
                          Click="OnSend" ToolTipService.ToolTip="发送数据 (Ctrl+Enter)" />
                </Grid>
              </StackPanel>
            </Border>
          </Grid>
        </SplitView>
      </Border>
    </Grid>

    <Grid Grid.Row="3" Padding="20,8" ColumnSpacing="20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="ConnectionStatus" Text="○ 未连接" FontSize="12" TextTrimming="CharacterEllipsis"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      <TextBlock x:Name="ByteStatus" Grid.Column="1" Text="RX 0 B    TX 0 B" FontSize="12" FontFamily="Consolas"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
  </Grid>
</Window>
